# Copy to .env.local and fill in. NEVER commit .env.local.
# Key names follow Supabase's current "publishable / secret" API keys
# (Dashboard -> Project Settings -> API Keys). Legacy anon/service_role keys also work.

# --- Needed from Phase 1 (template seeding) and Phase 2 (dashboard) ---
NEXT_PUBLIC_SUPABASE_URL=
# sb_publishable_... : safe in the browser, RLS applies
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# sb_secret_... : SERVER ONLY, bypasses RLS. Used by seed script and /api/ingest. Never prefix with NEXT_PUBLIC_.
SUPABASE_SECRET_KEY=

# The one email allowed to use the dashboard (also create exactly this user in Supabase Auth)
ALLOWED_EMAIL=

# --- Needed from Phase 3 (Gmail ingest) ---
# Long random string shared by Apps Script and /api/ingest.
# Generate: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
INGEST_SHARED_SECRET=
