{
  "name": "outreach-tracker",
  "version": "0.1.0",
  "private": true,
  "description": "Personal LinkedIn internship outreach tracker (single user, free tier only).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "seed:templates": "tsx --env-file=.env.local scripts/seed-templates.mts",
    "doctor": "tsx --env-file=.env.local scripts/doctor.mts",
    "sql:copy": "node scripts/print-sql.mjs | clip"
  },
  "devDependencies": {
    "@electric-sql/pglite": "^0.5.10",
    "@testing-library/dom": "^10.4.2",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^26.6.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.5"
  },
  "dependencies": {
    "@supabase/ssr": "^0.12.7",
    "@supabase/supabase-js": "^2.118.0",
    "next": "^16.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  }
}
